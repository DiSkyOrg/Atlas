{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Enabled": true,
    "Model": "anthropic/claude-haiku-4.5",
    "WeeklyBudgetUsd": 5.0,
    "MaxToolRounds": 5,
    "MaxOutputTokens": 1024,
    "MaxQuestionChars": 500,
    "PerIpPerMinute": 3,
    "PerIpPerDay": 20,
    "MaxConcurrent": 2
  }
}

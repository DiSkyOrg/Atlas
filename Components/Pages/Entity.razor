@page "/{EntityId}"
@inject ManifestService Manifest
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

@if (_entity is null)
{
    <PageTitle>Not found — DiSky Atlas</PageTitle>
    <div class="page">
        <div class="empty">
            <span class="empty-icon"><LucideIcon Name="search-x" /></span>
            <h2>Unknown entity</h2>
            <p>There's no entity called “@EntityId”. Open search with <kbd>⌘</kbd><kbd>K</kbd> or pick one from the sidebar.</p>
        </div>
    </div>
}
else
{
    <PageTitle>@Manifest.DisplayName(_entity) — DiSky Atlas</PageTitle>
    <div class="page">
        <nav class="crumb">
            <a href="/">Entities</a>
            @foreach (var ancestor in Manifest.Ancestors(_entity))
            {
                <span class="sep">/</span>
                <a href="/@ancestor.Id">@Manifest.DisplayName(ancestor)</a>
            }
            <span class="sep">/</span>
            <span class="cur">@Manifest.DisplayName(_entity)</span>
        </nav>

        <div class="page-head">
            <span class="head-icon"><LucideIcon Name="@ManifestService.EntityIcon(_entity)" /></span>
            <h1>@Manifest.DisplayName(_entity)</h1>
            <span class="badge kind-type"><span class="dot"></span>type</span>
        </div>

        <p class="page-lead">@EntityBlurbs.For(_entity, Manifest.DisplayName(_entity))</p>

        <div class="page-meta">
            <span class="chip chip-since">@_entity.Syntaxes.Count synta@(_entity.Syntaxes.Count == 1 ? "x" : "xes")</span>
            @if (Manifest.HasChildren(_entity.Id))
            {
                var n = Manifest.Children(_entity.Id).Count;
                <button type="button" class="chip chip-list chip-button" @onclick="OpenHierarchy" title="View subtype hierarchy">
                    <LucideIcon Name="git-fork" /> @n subtype@(n == 1 ? "" : "s")
                </button>
            }
            @if (_entity.ParentId is { } pid && Manifest.GetEntity(pid) is { } parent)
            {
                <a class="chip chip-return" href="/@parent.Id">extends @Manifest.DisplayName(parent)</a>
            }
            @if (!string.IsNullOrEmpty(_entity.JdaType))
            {
                var javadoc = ManifestService.JavadocUrl(_entity.JdaType);
                @if (javadoc is not null)
                {
                    <a class="page-jda jda-link" href="@javadoc" target="_blank" rel="noreferrer" title="Open the JDA Javadoc">
                        @_entity.JdaType<LucideIcon Name="external-link" />
                    </a>
                }
                else
                {
                    <span class="page-jda">@_entity.JdaType</span>
                }
            }
        </div>

        @{
            var visible = VisibleGroups.ToList();
            var matchCount = visible.Sum(g => g.Items.Count);
            var returnedBy = Manifest.ReturnedBy(_entity.Id);
            var sections = ManifestService.KindSections(visible).ToList();
            if (returnedBy.Count > 0)
                sections.Add(new SectionRef("returned-by", "Returned by", returnedBy.Count));
        }

        <SectionJump Sections="sections" />

        @if (_allGroups.Count > 0)
        {
            <div class="filter-bar">
                <span class="filter-icon"><LucideIcon Name="filter" /></span>
                <input class="filter-input" value="@_filter" @oninput="OnFilterInput"
                       placeholder="Filter… e.g. type:property since:>=5.0.0 change:set reactions"
                       spellcheck="false" autocomplete="off" aria-label="Filter syntaxes" />
                @if (!string.IsNullOrEmpty(_filter))
                {
                    <button type="button" class="filter-clear" @onclick="ClearFilter" title="Clear filter">
                        <LucideIcon Name="x" />
                    </button>
                }
                <span class="filter-count">@matchCount / @_entity.Syntaxes.Count</span>
            </div>
        }

        @if (_allGroups.Count == 0)
        {
            <div class="empty">
                <span class="empty-icon"><LucideIcon Name="box" /></span>
                <h2>No syntaxes here yet</h2>
                <p>
                    This type doesn't document any syntaxes directly@(Manifest.HasChildren(_entity.Id)
                        ? " — its subtypes in the sidebar do." : ".")
                </p>
            </div>
        }
        else if (visible.Count == 0)
        {
            <div class="empty">
                <span class="empty-icon"><LucideIcon Name="search-x" /></span>
                <h2>No matching syntaxes</h2>
                <p>Nothing matches “@_filter”. Try a broader query or clear the filter.</p>
            </div>
        }
        else
        {
            @foreach (var group in visible)
            {
                <section class="jump-section" id="@ManifestService.KindAnchor(group.Kind)">
                    <SectionHead Title="@group.Label" Count="group.Items.Count" />
                    @foreach (var syntax in group.Items)
                    {
                        <SyntaxRecord Syntax="syntax" EntityId="@_entity.Id" />
                    }
                </section>
            }
        }

        @if (returnedBy.Count > 0)
        {
            <section class="returns jump-section" id="returned-by">
                <SectionHead Title="Returned by" Count="returnedBy.Count" />
                <p class="returns-lead">Syntaxes elsewhere in DiSky that return @Manifest.DisplayName(_entity).</p>
                <div class="returns-list">
                    @foreach (var entry in returnedBy)
                    {
                        <a class="ret-row" href="@entry.Href">
                            @if (entry.Syntax.Patterns.FirstOrDefault() is { } retPattern)
                            {
                                <SignatureLine Pattern="@retPattern" Inline="true" />
                            }
                            else
                            {
                                <code class="signature-inline">@entry.Syntax.Name</code>
                            }
                            <span class="ret-src">@entry.SourceName</span>
                        </a>
                    }
                </div>
            </section>
        }
    </div>
}

<SubtypeDialog @ref="_hierarchy" />

@code {
    [Parameter] public string EntityId { get; set; } = "";

    private EntityInfo? _entity;
    private IReadOnlyList<KindGroup> _allGroups = [];
    private string _filter = "";
    private SyntaxFilter _parsedFilter = SyntaxFilter.Empty;
    private string? _lastEntityId;
    private string? _pendingHash;
    private bool _resetScroll;

    private IEnumerable<KindGroup> VisibleGroups =>
        _parsedFilter.IsEmpty
            ? _allGroups
            : _allGroups
                .Select(g => g with { Items = g.Items.Where(_parsedFilter.Matches).ToList() })
                .Where(g => g.Items.Count > 0);

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    protected override void OnParametersSet()
    {
        _entity = Manifest.GetEntity(EntityId);
        _allGroups = _entity is null ? [] : Manifest.GroupByKind(_entity.Syntaxes);

        _pendingHash = GetHash();
        if (!string.Equals(_lastEntityId, EntityId, StringComparison.OrdinalIgnoreCase))
        {
            _resetScroll = _pendingHash is null;
            _lastEntityId = EntityId;
            _filter = "";
            _parsedFilter = SyntaxFilter.Empty;
        }
    }

    private void OnFilterInput(ChangeEventArgs e)
    {
        _filter = e.Value?.ToString() ?? "";
        _parsedFilter = SyntaxFilter.Parse(_filter);
    }

    private void ClearFilter()
    {
        _filter = "";
        _parsedFilter = SyntaxFilter.Empty;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Fragment-only navigation (same entity, different #anchor) doesn't re-run
        // OnParametersSet, so handle the scroll target here.
        var hash = GetHash();
        if (hash is not null)
        {
            _pendingHash = hash;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingHash is { Length: > 0 } hash)
        {
            _pendingHash = null;
            _resetScroll = false;
            try { await JS.InvokeVoidAsync("atlas.scrollToId", hash, true); } catch { /* ignore */ }
        }
        else if (_resetScroll)
        {
            _resetScroll = false;
            try { await JS.InvokeVoidAsync("atlas.scrollTop", ".content"); } catch { /* ignore */ }
        }
    }

    private string? GetHash()
    {
        var uri = Nav.Uri;
        var i = uri.IndexOf('#');
        return i >= 0 && i < uri.Length - 1 ? uri[(i + 1)..] : null;
    }

    private SubtypeDialog _hierarchy = default!;
    private void OpenHierarchy() => _hierarchy.Open(_entity!);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

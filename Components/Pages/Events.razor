@page "/events"
@inject ManifestService Manifest
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Events | DiSky Atlas</PageTitle>

<div class="page">
    <BbBreadcrumb Class="crumb">
        <BbBreadcrumbList AutoSeparator="true">
            <SeparatorContent><span class="sep">/</span></SeparatorContent>
            <ChildContent>
                <BbBreadcrumbItem><BbBreadcrumbLink Href="/">Overview</BbBreadcrumbLink></BbBreadcrumbItem>
                <BbBreadcrumbItem><BbBreadcrumbPage Class="cur">Events</BbBreadcrumbPage></BbBreadcrumbItem>
            </ChildContent>
        </BbBreadcrumbList>
    </BbBreadcrumb>

    <div class="page-head">
        <span class="head-icon"><LucideIcon Name="zap" /></span>
        <h1>Events</h1>
        <DotBadge Class="kind-event" Label="event" />
    </div>

    <p class="page-lead">
        Every Discord event DiSky can listen to. Each event exposes <code>event-value</code>s
        (accessed by type) and event-scoped expressions you can use inside its handler.
    </p>

    <div class="page-meta">
        <span class="chip chip-since">@Manifest.Events.Count events</span>
    </div>

    @{
        var filtered = Manifest.Events.Where(_parsedFilter.Matches).ToList();
        var groups = filtered
            .GroupBy(ManifestService.EventCategory)
            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
        var sections = groups
            .Select(g => new SectionRef(ManifestService.CategoryAnchor(g.Key), g.Key, g.Count()))
            .ToList();
    }

    <SectionJump Sections="sections" />

    <FilterBar Value="@_filter" ValueChanged="SetFilter"
               Placeholder="Filter events… e.g. since:>=5.0.0 cancellable:true intent:members message"
               AriaLabel="Filter events"
               MatchCount="filtered.Count" Total="Manifest.Events.Count" />

    @if (filtered.Count == 0)
    {
        <EmptyState Icon="search-x" Title="No matching events">
            <p>Nothing matches “@_filter”. Try a broader query or clear the filter.</p>
        </EmptyState>
    }
    else
    {
        @foreach (var group in groups)
        {
            <section class="jump-section" id="@ManifestService.CategoryAnchor(group.Key)">
                <SectionHead Title="@group.Key" Count="group.Count()" />
                @foreach (var ev in group)
                {
                    <SyntaxRecord Syntax="ev" EntityId="event" LinkPath="/events" />
                }
            </section>
        }
    }
</div>

@code {
    private string _filter = "";
    private SyntaxFilter _parsedFilter = SyntaxFilter.Empty;
    private string? _pendingHash;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        _pendingHash = GetHash();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var hash = GetHash();
        if (hash is not null)
        {
            _pendingHash = hash;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingHash is { Length: > 0 } hash)
        {
            _pendingHash = null;
            try { await JS.InvokeVoidAsync("atlas.scrollToId", hash, true); } catch { /* ignore */ }
        }
    }

    private void SetFilter(string value)
    {
        _filter = value;
        _parsedFilter = SyntaxFilter.Parse(_filter);
    }

    private string? GetHash()
    {
        var uri = Nav.Uri;
        var i = uri.IndexOf('#');
        return i >= 0 && i < uri.Length - 1 ? uri[(i + 1)..] : null;
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

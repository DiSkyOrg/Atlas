@page "/"
@inject ManifestService Manifest
@inject DocsService Docs

<PageTitle>DiSky Atlas | Skript-for-Discord syntax reference</PageTitle>

<div class="home">
    <div class="home-hero">
        <img src="assets/disky-logo.png" alt="DiSky" width="56" height="56" />
        <h1>DiSky Atlas</h1>
        <span class="vtag">@Version</span>
    </div>

    <p class="home-lead">
        A javadoc-style reference for <strong>DiSky</strong>. Browse every Discord entity and the
        exhaustive list of Skript syntaxes it exposes: real patterns, return types, change modes and
        copyable examples, generated straight from the plugin. Press
        <kbd>⌘</kbd><kbd>K</kbd> to search anything.
    </p>

    <div class="home-stats">
        <StatTile Number="EntityCount" Label="Entities" />
        <StatTile Number="SyntaxCount" Label="Syntaxes" />
        <StatTile Number="EventCount" Label="Events" />
        <StatTile Number="TypeCount" Label="Types" />
    </div>

    @if (Docs.Sections.Count > 0)
    {
        <div class="home-section-head">
            <div class="label-eyebrow home-section-label">Documentation</div>
            <a class="home-section-more" href="/docs">All guides <LucideIcon aria-hidden="true" Name="arrow-right" /></a>
        </div>
        <div class="home-grid home-docs">
            @foreach (var docSection in Docs.Sections)
            {
                var count = docSection.Pages.Count + (docSection.Index is null ? 0 : 1);
                <a class="ecard ecard-doc" href="@SectionHref(docSection)">
                    <div class="ec-head">
                        <span class="ec-icon"><LucideIcon aria-hidden="true" Name="@(docSection.Icon ?? "book-open")" /></span>
                        <span class="ec-name">@docSection.Title</span>
                    </div>
                    @if (docSection.Index?.Description is { Length: > 0 } description)
                    {
                        <div class="ec-desc">@description</div>
                    }
                    <div class="ec-count">@count page@(count == 1 ? "" : "s")</div>
                </a>
            }
        </div>
    }

    <div class="label-eyebrow home-section-label">Atlas</div>
    <a class="ecard ecard-wide" href="/events">
        <div class="ec-head">
            <span class="ec-icon"><LucideIcon aria-hidden="true" Name="zap" /></span>
            <span class="ec-name">Events</span>
        </div>
        <div class="ec-desc">
            Every Discord event you can listen to (message, guild, member, voice, interaction…), each
            with its <code>event-value</code>s and event-scoped expressions.
        </div>
        <div class="ec-count">@EventCount events</div>
    </a>

    <div class="label-eyebrow home-section-label">Entities</div>
    <div class="home-grid">
        @foreach (var entity in Manifest.Roots)
        {
            var total = Manifest.TotalSyntaxCount(entity);
            <a class="ecard" href="/@entity.Id">
                <div class="ec-head">
                    <span class="ec-icon"><LucideIcon aria-hidden="true" Name="@ManifestService.EntityIcon(entity)" /></span>
                    <span class="ec-name">@Manifest.DisplayName(entity)</span>
                </div>
                <div class="ec-desc">@EntityBlurbs.For(entity, Manifest.DisplayName(entity))</div>
                <div class="ec-count">@total synta@(total == 1 ? "x" : "xes")</div>
            </a>
        }
    </div>
</div>

@code {
    private string Version => "v" + (Manifest.Manifest.DiskyVersion?.Split('.').FirstOrDefault() ?? "5");
    private int EntityCount => Manifest.Manifest.Entities.Count;
    private int SyntaxCount => Manifest.Manifest.Entities.Sum(e => e.Syntaxes.Count) + Manifest.Manifest.Core.Count;
    private int EventCount => Manifest.Events.Count;
    private int TypeCount => Manifest.Manifest.Types.Count;

    private static string SectionHref(DocSection section) =>
        section.Index is not null ? $"/docs/{section.Id}" : $"/docs/{section.Pages.FirstOrDefault()?.Slug}";
}

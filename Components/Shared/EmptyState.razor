@* Centered page-level empty/error state. Shared shell for every ".empty"
   block; kept maison (BbEmpty's h3 + string-only description can't host the
   rich content (kbd hints, links, action buttons) these states carry). *@
<div class="empty">
    <span class="empty-icon"><LucideIcon Name="@Icon" /></span>
    <h2>@Title</h2>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

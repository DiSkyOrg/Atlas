@* Inline filter bar: icon + reset-styled input + clear button + match count.
   The input stays native (BbInputGroup brings its own chrome; this bar is a
   borderless strip) but the shell is shared by every syntax-list page. *@
<div class="filter-bar">
    <span class="filter-icon"><LucideIcon aria-hidden="true" Name="filter" /></span>
    <input class="filter-input" value="@Value" @oninput="OnInput"
           placeholder="@Placeholder"
           spellcheck="false" autocomplete="off" aria-label="@AriaLabel" />
    @if (!string.IsNullOrEmpty(Value))
    {
        <button type="button" class="filter-clear" @onclick="ClearAsync" title="Clear filter">
            <LucideIcon aria-hidden="true" Name="x" />
        </button>
    }
    <span class="filter-count">@MatchCount / @Total</span>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Filter…";
    [Parameter] public string AriaLabel { get; set; } = "Filter";
    [Parameter] public int MatchCount { get; set; }
    [Parameter] public int Total { get; set; }

    private Task OnInput(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
    private Task ClearAsync() => ValueChanged.InvokeAsync("");
}

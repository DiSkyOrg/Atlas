@* One node in the entity tree, on Blueprint's TreeView. Recurses for children.
   The label is a real <a href> (middle-click, crawlability); the chevron
   (rendered and wired by Blueprint) toggles expansion without navigating. *@
@inject ManifestService Manifest

@if (HasChildren)
{
    <BbTreeItem Value="@Entity.Id" Class="@RowClass">
        <LabelTemplate>
            <a class="tree-link" href="/@Entity.Id" @onclick="HandleNavigate">
                <span class="label">@Manifest.DisplayName(Entity)</span>
                @if (Entity.Syntaxes.Count > 0)
                {
                    <span class="count">@Entity.Syntaxes.Count</span>
                }
            </a>
        </LabelTemplate>
        <ChildContent>
            @foreach (var child in Manifest.Children(Entity.Id))
            {
                <TreeNode Entity="child" ActiveId="@ActiveId" OnNavigate="OnNavigate" />
            }
        </ChildContent>
    </BbTreeItem>
}
else
{
    <BbTreeItem Value="@Entity.Id" Class="@RowClass" IsLeaf="true">
        <LabelTemplate>
            <a class="tree-link" href="/@Entity.Id" @onclick="HandleNavigate">
                <span class="leaf-icon"><LucideIcon Name="@ManifestService.EntityIcon(Entity)" /></span>
                <span class="label">@Manifest.DisplayName(Entity)</span>
                @if (Entity.Syntaxes.Count > 0)
                {
                    <span class="count">@Entity.Syntaxes.Count</span>
                }
            </a>
        </LabelTemplate>
    </BbTreeItem>
}

@code {
    [Parameter, EditorRequired] public EntityInfo Entity { get; set; } = default!;
    [Parameter] public string? ActiveId { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool HasChildren => Manifest.HasChildren(Entity.Id);
    private bool IsActive => string.Equals(ActiveId, Entity.Id, StringComparison.OrdinalIgnoreCase);
    private string RowClass => IsActive ? "tree-row active" : "tree-row";

    private Task HandleNavigate() => OnNavigate.InvokeAsync();
}

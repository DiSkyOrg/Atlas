@* Fixed top bar: sidebar toggle (mobile) · brand · search trigger · GitHub · theme. *@
@inject ManifestService Manifest

<header class="topbar">
    <button type="button" class="icon-btn sidebar-toggle" title="Toggle sidebar"
            aria-label="Toggle sidebar" @onclick="ToggleSidebarAsync">
        <LucideIcon Name="panel-left" />
    </button>

    <a class="brand" href="/">
        <img src="assets/disky-logo.png" alt="DiSky" />
        <span class="name">DiSky</span>
        <span class="vtag" title="Latest documented syntax version">@Version</span>
    </a>

    <div class="spacer"></div>

    <button type="button" class="search-trigger" @onclick="OpenPaletteAsync">
        <LucideIcon Name="search" />
        <span class="label-text">Search entities &amp; syntaxes…</span>
        <span class="kbd"><kbd>⌘</kbd><kbd>K</kbd></span>
    </button>

    <BbTooltip Placement="PopoverPlacement.Bottom">
        <BbTooltipTrigger AsChild="false" Focusable="false" Class="tipwrap">
            <a class="icon-btn" href="https://github.com/DiSkyOrg/DiSky" target="_blank" rel="noreferrer" aria-label="DiSky on GitHub">
                <LucideIcon Name="github" />
            </a>
        </BbTooltipTrigger>
        <BbTooltipContent>DiSky on GitHub</BbTooltipContent>
    </BbTooltip>

    <BbTooltip Placement="PopoverPlacement.Bottom">
        <BbTooltipTrigger AsChild="false" Focusable="false" Class="tipwrap">
            <button type="button" class="icon-btn" aria-label="Display options" @onclick="OpenSettings">
                <LucideIcon Name="settings" />
            </button>
        </BbTooltipTrigger>
        <BbTooltipContent>Display options</BbTooltipContent>
    </BbTooltip>

    <ThemeToggle />
</header>

<SettingsDialog @ref="_settings" />

@code {
    [Parameter] public EventCallback OnOpenPalette { get; set; }
    [Parameter] public EventCallback OnToggleSidebar { get; set; }

    private SettingsDialog _settings = default!;

    private string Version =>
        "v" + (Manifest.LatestVersion ?? Manifest.Manifest.DiskyVersion ?? "5");

    private Task OpenPaletteAsync() => OnOpenPalette.InvokeAsync();
    private Task ToggleSidebarAsync() => OnToggleSidebar.InvokeAsync();
    private Task OpenSettings() => _settings.Open();
}

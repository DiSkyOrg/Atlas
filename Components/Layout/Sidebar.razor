@* Sidebar: search trigger, then Blueprint tabs splitting the nav into "Atlas"
   (reference + entity tree) and "Documentation" (docs tree). Tab selection
   follows the route (docs/* → Documentation); a manual tab click wins until
   the next navigation. Trees are Blueprint TreeViews (see TreeNode/DocsNav). *@
@inject ManifestService Manifest
@inject DiSkyAtlas.Services.Docs.DocsService Docs
@inject NavigationManager Nav
@implements IDisposable

<nav class="sidebar @(Open ? "open" : "")">
    <button type="button" class="side-search" @onclick="OpenPaletteAsync">
        <LucideIcon Name="search" />
        <span>Search…</span>
        <span class="kbd">⌘K</span>
    </button>

    @if (Docs.HasDocs)
    {
        <BbTabs Value="@_tab" ValueChanged="OnTabClicked" Class="side-tabs">
            <BbTabsList Class="side-tabs-list">
                <BbTabsTrigger Value="atlas" Class="side-tab">Atlas</BbTabsTrigger>
                <BbTabsTrigger Value="docs" Class="side-tab">Documentation</BbTabsTrigger>
            </BbTabsList>

            <BbTabsContent Value="atlas">
                @AtlasNav
            </BbTabsContent>

            <BbTabsContent Value="docs">
                <div class="group">
                    <DiSkyAtlas.Components.Docs.DocsNav OnNavigate="NavigatedAsync" />
                </div>
            </BbTabsContent>
        </BbTabs>
    }
    else
    {
        @AtlasNav
    }
</nav>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnOpenPalette { get; set; }
    [Parameter] public EventCallback OnNavigated { get; set; }

    private HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private string? _activeId;
    private string? _tab = "atlas";

    private RenderFragment AtlasNav => __builder =>
    {
        <div class="group">
            <div class="group-label">Reference</div>
            <a class="tree-row @(string.Equals(_activeId, "events", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
               href="/events" @onclick="NavigatedAsync">
                <span class="leaf-icon"><LucideIcon Name="zap" /></span>
                <span class="label">Events</span>
                <span class="count">@Manifest.Events.Count</span>
            </a>
        </div>

        @if (Manifest.HasCore)
        {
            <div class="group">
                <div class="group-label">Core / Global</div>
                @foreach (var kind in Manifest.CoreKinds)
                {
                    var slug = ManifestService.KindPlural(kind);
                    <a class="tree-row @(string.Equals(_activeId, $"core/{slug}", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       href="/core/@slug" @onclick="NavigatedAsync">
                        <span class="leaf-icon"><LucideIcon Name="@ManifestService.KindIcon(kind)" /></span>
                        <span class="label">@ManifestService.KindLabel(kind)</span>
                        <span class="count">@Manifest.CoreSyntaxes(kind).Count</span>
                    </a>
                }
            </div>
        }

        <div class="group">
            <div class="group-label">Entities</div>
            <BbTreeView TItem="string" AriaLabel="Entities"
                        ExpandedValues="_expanded" ExpandedValuesChanged="OnExpandedChanged">
                @foreach (var root in Manifest.Roots)
                {
                    <TreeNode Entity="root" ActiveId="@_activeId" OnNavigate="NavigatedAsync" />
                }
            </BbTreeView>
        </div>
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
        _tab = TabForRoute();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActive();
        _tab = TabForRoute();
        InvokeAsync(StateHasChanged);
    }

    private string TabForRoute() =>
        _activeId is not null && _activeId.StartsWith("docs", StringComparison.OrdinalIgnoreCase)
            ? "docs" : "atlas";

    private void OnTabClicked(string? tab) => _tab = tab ?? "atlas";

    private void UpdateActive()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        _activeId = string.IsNullOrEmpty(path) ? null : Uri.UnescapeDataString(path);

        var entity = Manifest.GetEntity(_activeId);
        if (entity is null) return;

        foreach (var ancestor in Manifest.Ancestors(entity))
            _expanded.Add(ancestor.Id);
        if (Manifest.HasChildren(entity.Id))
            _expanded.Add(entity.Id);
    }

    private void OnExpandedChanged(HashSet<string> values) =>
        _expanded = new HashSet<string>(values, StringComparer.OrdinalIgnoreCase);

    private Task OpenPaletteAsync() => OnOpenPalette.InvokeAsync();
    private Task NavigatedAsync() => OnNavigated.InvokeAsync();

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

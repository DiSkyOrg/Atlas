@* "shared" marker — the same syntax is registered on several entities. *@
<BbTooltip Placement="PopoverPlacement.Top">
    <BbTooltipTrigger AsChild="false" Focusable="false" Class="tipwrap">
        <span class="chip chip-shared">shared</span>
    </BbTooltipTrigger>
    <BbTooltipContent>Appears on several entities.</BbTooltipContent>
</BbTooltip>

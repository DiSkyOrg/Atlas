@* Section heading: title + optional count + a right-aligned back-to-top button. *@
@inject IJSRuntime JS

<div class="section-head">
    @if (Icon is { Length: > 0 })
    {
        <span class="sh-icon"><LucideIcon aria-hidden="true" Name="@Icon" /></span>
    }
    <h2>
        @if (Href is { Length: > 0 })
        {
            <a class="sh-link" href="@Href">@Title</a>
        }
        else
        {
            @Title
        }
    </h2>
    @if (Count is not null)
    {
        <span class="n">@Count</span>
    }
    <BbTooltip Placement="PopoverPlacement.Top">
        <BbTooltipTrigger AsChild="false" Focusable="false" Class="tipwrap to-top-wrap">
            <button type="button" class="to-top" @onclick="ScrollTopAsync" aria-label="Back to top">
                <LucideIcon aria-hidden="true" Name="arrow-up" />
            </button>
        </BbTooltipTrigger>
        <BbTooltipContent>Back to top</BbTooltipContent>
    </BbTooltip>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public int? Count { get; set; }

    /// <summary>Optional Lucide icon shown before the title (used by the per-entity sections on /effects).</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>When set, the title links there — e.g. an entity section pointing at that entity's page.</summary>
    [Parameter] public string? Href { get; set; }

    private async Task ScrollTopAsync()
    {
        try { await JS.InvokeVoidAsync("atlas.scrollTop", ".content", true); } catch { /* ignore */ }
    }
}

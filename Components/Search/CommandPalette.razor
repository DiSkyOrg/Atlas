@* ⌘K command palette: fuzzy search across entities + syntaxes + docs, grouped
   results. Blueprint's CommandDialog owns the overlay, focus, keyboard nav and
   the Ctrl/⌘+K shortcut (IKeyboardShortcutService); the ranking stays ours, so
   Blueprint-side filtering is disabled and only pre-scored rows are rendered. *@
@inject ManifestService Manifest
@inject SearchService Search
@inject NavigationManager Nav
@inject IKeyboardShortcutService Shortcuts
@implements IDisposable

@* The hotkey is registered here rather than via the dialog's Shortcut param:
   the internal toggle bypasses OpenChanged, leaving the parent's Open param
   stale; the next re-render would slam the dialog shut. *@
<BbCommandDialog Open="@_open" OpenChanged="OnOpenChanged"
                 SearchQueryChanged="OnQueryChanged" FilterFunction="AlwaysMatch"
                 Class="palette">
    @* Debounce stays on (Blueprint default): in InteractiveServer every keystroke
       is a server round-trip + a re-render of up to 60 rows. *@
    <BbCommandInput Placeholder="Search entities, syntaxes & docs…" AutoFocus="true" />

    @* Result count for screen readers; the visual list itself isn't announced. *@
    <div class="sr-only" aria-live="polite">@(_flat.Count == 0 ? "No results" : $"{_flat.Count} results")</div>

    <BbCommandList Class="pal-results">
        @if (_flat.Count == 0)
        {
            <div class="pal-empty">No results for “@_query”. Try a broader term.</div>
        }
        else
        {
            var index = 0;
            @foreach (var (label, items) in Groups())
            {
                <div class="pal-group">@label</div>
                foreach (var item in items)
                {
                    var current = item;
                    var i = index++;
                    <BbCommandItem Value="@i.ToString()" Class="pal-row" OnSelect="() => Choose(current)">
                        <span class="pn">@current.Name</span>
                        <DotBadge Class="@("kind-" + current.Kind)" Label="@current.Kind" />
                        <span class="par">@current.Parent</span>
                    </BbCommandItem>
                }
            }
        }
    </BbCommandList>

    <div class="pal-foot">
        <span><span class="k">↑↓</span>navigate</span>
        <span><span class="k">↵</span>open</span>
        <span><span class="k">esc</span>close</span>
    </div>
</BbCommandDialog>

@code {
    private bool _open;
    private string _query = "";

    private List<SearchItem> _entities = [];
    private List<SearchItem> _docs = [];
    private List<SearchItem> _events = [];
    private List<SearchItem> _syntaxes = [];
    private List<SearchItem> _flat = [];

    private static bool AlwaysMatch(CommandItemMetadata item, string query) => true;

    private IDisposable? _hotkey;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _hotkey = await Shortcuts.RegisterAsync("Ctrl+K",
                () => InvokeAsync(() => OnOpenChanged(true)));
        }
        catch { /* JS not ready during prerender */ }
    }

    public Task Open()
    {
        OnOpenChanged(true);
        return Task.CompletedTask;
    }

    private void OnOpenChanged(bool open)
    {
        _open = open;
        if (open)
        {
            _query = "";
            Recompute();
        }
        StateHasChanged();
    }

    private void OnQueryChanged(string query)
    {
        _query = query;
        Recompute();
    }

    private IEnumerable<(string Label, List<SearchItem> Items)> Groups()
    {
        if (_entities.Count > 0) yield return ("Entities", _entities);
        if (_docs.Count > 0) yield return ("Documentation", _docs);
        if (_events.Count > 0) yield return ("Events", _events);
        if (_syntaxes.Count > 0) yield return ("Syntaxes", _syntaxes);
    }

    private void Choose(SearchItem item)
    {
        _open = false;
        Nav.NavigateTo(SearchService.SiteUrl(item));
    }

    private void Recompute()
    {
        var query = _query.Trim();

        if (query.Length == 0)
        {
            _entities = Manifest.SearchIndex.Where(r => r.Type == "entity").Take(60).ToList();
            _docs = [];
            _events = [];
            _syntaxes = [];
        }
        else
        {
            var scored = Search.Search(query, 50).Select(h => h.Item).ToList();

            _entities = scored.Where(r => r.Type == "entity").ToList();
            _docs = scored.Where(r => r.Type == "doc").ToList();
            _events = scored.Where(r => r.Type == "event").ToList();
            _syntaxes = scored.Where(r => r.Type == "syntax").ToList();
        }

        _flat = [.. _entities, .. _docs, .. _events, .. _syntaxes];
    }

    public void Dispose() => _hotkey?.Dispose();
}

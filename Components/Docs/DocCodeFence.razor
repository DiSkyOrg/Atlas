@* Fenced/indented code. ```skript fences reuse the highlighted SkriptCodeBlock; any other
   language renders as a plain (escaped) code block with a copy button + language caption. *@
@using Markdig.Syntax

@if (IsSkript)
{
    <SkriptCodeBlock Code="@Code" />
}
else
{
    <div class="code-block">
        <CopyButton Text="@Code" />
        <pre>@Code</pre>
        @if (Language is { Length: > 0 })
        {
            <div class="code-caption">@Language</div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public CodeBlock Block { get; set; } = default!;

    private string? Language => (Block as FencedCodeBlock)?.Info?.Trim().ToLowerInvariant();

    private bool IsSkript => Language is "skript" or "sk";

    private string Code
    {
        get
        {
            var lines = Block.Lines;
            var sb = new System.Text.StringBuilder();
            for (var i = 0; i < lines.Count; i++)
            {
                if (i > 0) sb.Append('\n');
                sb.Append(lines.Lines[i].Slice.AsSpan());
            }
            return sb.ToString();
        }
    }
}

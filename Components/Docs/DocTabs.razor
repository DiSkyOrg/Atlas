@* mkdocs-style content tabs (=== "Title"). Consecutive tab blocks are grouped by
   DocBlocks; Blueprint tabs own the active state, roles and keyboard nav — the
   .doc-tab* classes keep the enclosed DiSky look. *@
@using DiSkyAtlas.Services.Docs

<BbTabs DefaultValue="0" Class="doc-tabs">
    <BbTabsList Class="doc-tabs-list">
        @for (var i = 0; i < Tabs.Count; i++)
        {
            var index = i;
            <BbTabsTrigger Value="@index.ToString()" Class="doc-tab">@Tabs[index].Title</BbTabsTrigger>
        }
    </BbTabsList>
    @for (var i = 0; i < Tabs.Count; i++)
    {
        var index = i;
        <BbTabsContent Value="@index.ToString()" Class="doc-tabs-panel">
            <DocBlocks Blocks="Tabs[index]" />
        </BbTabsContent>
    }
</BbTabs>

@code {
    [Parameter, EditorRequired] public List<TabItemBlock> Tabs { get; set; } = [];
}

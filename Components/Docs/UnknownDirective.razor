@* Degraded box for a directive/container name the registry doesn't know. *@
<div class="doc-unknown">
    <LucideIcon aria-hidden="true" Name="triangle-alert" />
    <span>Unknown doc component <code>@Name</code>.</span>
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
}

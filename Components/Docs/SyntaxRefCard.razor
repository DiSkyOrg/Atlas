@* Simplified syntax card for doc pages (`syntax: guild#ban`). Clicking it lands on the real
   record with the existing deep-link force-open + flash. The amount of detail follows the
   user's "Documentation" settings (html[data-doc-card]) unless the author forces a level
   per card (`syntax: guild#ban full`); both are pure CSS, no re-render. *@
@using DiSkyAtlas.Models
@using DiSkyAtlas.Services.Docs
@inject ManifestService Manifest
@inject DocsService Docs

@if (Reference is not { } reference || !reference.Resolved)
{
    <div class="sref sref-missing">
        <span class="sref-missing-icon"><LucideIcon Name="triangle-alert" /></span>
        <span>
            Unknown reference <code>@(Reference?.Raw ?? Context?.Argument)</code>; check the id
            (copy it from the syntax's link button on its atlas page).
        </span>
    </div>
}
else if (reference.Syntax is { } syntax)
{
    <a class="sref" href="@reference.Href" data-detail="@DetailOverride">
        <span class="sref-head">
            <KindBadge Kind="syntax.Kind" />
            <span class="sref-name">@syntax.Name</span>
            @if (syntax.Deprecated)
            {
                <DotBadge Class="badge-deprecated" Label="deprecated" />
            }
            <span class="sref-src">@SourceLabel(reference)</span>
        </span>
        @if (syntax.Patterns.FirstOrDefault() is { } pattern)
        {
            <span class="sref-pattern"><SignatureLine Pattern="@pattern" Inline="true" /></span>
        }
        @if (syntax.Description.FirstOrDefault() is { Length: > 0 } description)
        {
            <span class="sref-desc">@description</span>
        }
        <span class="sref-meta">
            @if (syntax.ReturnType is not null)
            {
                <ReturnTypeChip Type="syntax.ReturnType" List="syntax.ReturnList" />
            }
            @if (!string.IsNullOrEmpty(syntax.Since))
            {
                <SinceChip Since="@syntax.Since" />
            }
        </span>
    </a>
}
else if (reference.EntityId is { } entityId && Manifest.GetEntity(entityId) is { } entity)
{
    <a class="sref sref-entity" href="@reference.Href" data-detail="@DetailOverride">
        <span class="sref-head">
            <span class="sref-icon"><LucideIcon Name="@ManifestService.EntityIcon(entity)" /></span>
            <span class="sref-name">@Manifest.DisplayName(entity)</span>
            <DotBadge Class="kind-type" Label="type" />
            <span class="sref-src">@entity.Syntaxes.Count synta@(entity.Syntaxes.Count == 1 ? "x" : "xes")</span>
        </span>
        <span class="sref-desc">@EntityBlurbs.For(entity, Manifest.DisplayName(entity))</span>
    </a>
}

@code {
    /// <summary>Registry contract; set when the card comes from a `syntax:`/`entity:`/`event:` directive.</summary>
    [Parameter] public DocDirectiveContext? Context { get; set; }

    /// <summary>Direct usage (e.g. the "Related syntaxes" section on a doc page).</summary>
    [Parameter] public AtlasRef? Ref { get; set; }

    /// <summary>Forced detail level for direct usage ("compact" | "standard" | "full").</summary>
    [Parameter] public string? Detail { get; set; }

    private AtlasRef? Reference =>
        Ref
        ?? Context?.ResolvedRef
        ?? (Context is { } context ? Docs.Resolve($"{context.Name}:{context.Argument}") : null);

    private string? DetailOverride
    {
        get
        {
            if (Detail is not null) return Detail;
            if (Context is not { } context) return null;
            if (context.Options.ContainsKey("full")) return "full";
            if (context.Options.ContainsKey("compact")) return "compact";
            if (context.Options.ContainsKey("standard")) return "standard";
            return null;
        }
    }

    private string SourceLabel(AtlasRef reference) => reference.EntityId switch
    {
        "events" => "Events",
        "core" when reference.Syntax is { } s => $"Core · {ManifestService.KindLabel(s.Kind)}",
        { } entityId => Manifest.DisplayName(entityId),
        _ => ""
    };
}

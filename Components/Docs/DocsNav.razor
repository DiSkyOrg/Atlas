@* Documentation tree on Blueprint's TreeView: one expandable node per section,
   page rows nested under it. Row look and active/auto-expand behavior mirror
   the entity tree (tree-row / tree-link / active). *@
@using DiSkyAtlas.Models
@using DiSkyAtlas.Services.Docs
@inject DocsService Docs
@inject NavigationManager Nav
@implements IDisposable

<BbTreeView TItem="string" AriaLabel="Documentation"
            ExpandedValues="_expanded" ExpandedValuesChanged="OnExpandedChanged">
    @foreach (var docSection in Docs.Sections)
    {
        var section = docSection;
        @if (section.Pages.Count > 0)
        {
            <BbTreeItem Value="@section.Id" Class="@RowClass(SectionSlug(section))">
                <LabelTemplate>
                    <a class="tree-link" href="@SectionHref(section)" @onclick="() => NavigatedAsync(section)">
                        <span class="label">@section.Title</span>
                        <span class="count">@(section.Pages.Count + (section.Index is null ? 0 : 1))</span>
                    </a>
                </LabelTemplate>
                <ChildContent>
                    @foreach (var docPage in section.Pages)
                    {
                        <BbTreeItem Value="@docPage.Slug" Class="@RowClass($"docs/{docPage.Slug}")" IsLeaf="true">
                            <LabelTemplate>
                                <a class="tree-link" href="@($"/docs/{docPage.Slug}")" @onclick="() => NavigatedAsync(null)">
                                    <span class="leaf-icon"><LucideIcon aria-hidden="true" Name="@(docPage.Icon ?? "file-text")" /></span>
                                    <span class="label">@docPage.Title</span>
                                </a>
                            </LabelTemplate>
                        </BbTreeItem>
                    }
                </ChildContent>
            </BbTreeItem>
        }
        else
        {
            <BbTreeItem Value="@section.Id" Class="@RowClass(SectionSlug(section))" IsLeaf="true">
                <LabelTemplate>
                    <a class="tree-link" href="@SectionHref(section)" @onclick="() => NavigatedAsync(section)">
                        <span class="leaf-icon"><LucideIcon aria-hidden="true" Name="@(section.Icon ?? "book-open")" /></span>
                        <span class="label">@section.Title</span>
                        <span class="count">@(section.Index is null ? 0 : 1)</span>
                    </a>
                </LabelTemplate>
            </BbTreeItem>
        }
    }
</BbTreeView>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private string? _activePath;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActive();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateActive()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        _activePath = string.IsNullOrEmpty(path) ? null : Uri.UnescapeDataString(path);

        // Auto-expand the section owning the active page.
        if (_activePath is not null && _activePath.StartsWith("docs/", StringComparison.OrdinalIgnoreCase))
        {
            var sectionId = _activePath["docs/".Length..].Split('/')[0];
            if (sectionId.Length > 0)
                _expanded.Add(sectionId);
        }
    }

    private void OnExpandedChanged(HashSet<string> values) =>
        _expanded = new HashSet<string>(values, StringComparer.OrdinalIgnoreCase);

    private string RowClass(string path) =>
        string.Equals(_activePath, path, StringComparison.OrdinalIgnoreCase) ? "tree-row active" : "tree-row";

    private static string SectionSlug(DocSection section) =>
        section.Index is not null ? $"docs/{section.Id}" : $"docs/{section.Pages.FirstOrDefault()?.Slug}";

    private static string SectionHref(DocSection section) => "/" + SectionSlug(section);

    private Task NavigatedAsync(DocSection? section)
    {
        if (section is not null)
            _expanded.Add(section.Id);
        return OnNavigate.InvokeAsync();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

@* Sidebar rows for the Documentation group: one expandable row per section, page rows
   nested under it. Mirrors the entity tree's look (tree-row / nest / active). *@
@using DiSkyAtlas.Models
@using DiSkyAtlas.Services.Docs
@inject DocsService Docs
@inject NavigationManager Nav
@implements IDisposable

@foreach (var docSection in Docs.Sections)
{
    var section = docSection;
    var expanded = IsExpanded(section);
    <a class="tree-row @(IsActive(SectionSlug(section)) ? "active" : "")" href="@SectionHref(section)"
       @onclick="() => NavigatedAsync(section)">
        @if (section.Pages.Count > 0)
        {
            <span class="chev @(expanded ? "open" : "")"
                  @onclick="() => Toggle(section.Id)" @onclick:preventDefault @onclick:stopPropagation>
                <LucideIcon Name="chevron-right" />
            </span>
        }
        else
        {
            <span class="leaf-icon"><LucideIcon Name="@(section.Icon ?? "book-open")" /></span>
        }
        <span class="label">@(section.Title)</span>
        <span class="count">@(section.Pages.Count + (section.Index is null ? 0 : 1))</span>
    </a>
    @if (expanded && section.Pages.Count > 0)
    {
        <div class="nest">
            @foreach (var docPage in section.Pages)
            {
                <a class="tree-row @(IsActive($"docs/{docPage.Slug}") ? "active" : "")" href="@($"/docs/{docPage.Slug}")"
                   @onclick="() => NavigatedAsync(null)">
                    <span class="leaf-icon"><LucideIcon Name="@(docPage.Icon ?? "file-text")" /></span>
                    <span class="label">@docPage.Title</span>
                </a>
            }
        </div>
    }
}

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private string? _activePath;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UpdateActive();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdateActive();
        InvokeAsync(StateHasChanged);
    }

    private void UpdateActive()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        _activePath = string.IsNullOrEmpty(path) ? null : Uri.UnescapeDataString(path);

        // Auto-expand the section owning the active page.
        if (_activePath is not null && _activePath.StartsWith("docs/", StringComparison.OrdinalIgnoreCase))
        {
            var sectionId = _activePath["docs/".Length..].Split('/')[0];
            if (sectionId.Length > 0)
                _expanded.Add(sectionId);
        }
    }

    private bool IsActive(string path) =>
        string.Equals(_activePath, path, StringComparison.OrdinalIgnoreCase);

    private bool IsExpanded(DocSection section) => _expanded.Contains(section.Id);

    private static string SectionSlug(DocSection section) =>
        section.Index is not null ? $"docs/{section.Id}" : $"docs/{section.Pages.FirstOrDefault()?.Slug}";

    private static string SectionHref(DocSection section) => "/" + SectionSlug(section);

    private void Toggle(string id)
    {
        if (!_expanded.Add(id))
            _expanded.Remove(id);
    }

    private Task NavigatedAsync(DocSection? section)
    {
        if (section is not null)
            _expanded.Add(section.Id);
        return OnNavigate.InvokeAsync();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

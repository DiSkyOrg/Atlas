<!DOCTYPE html>
<html lang="en" class="dark" data-syntax-display="compact" data-doc-card="standard" data-doc-toc="on">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>

    @* Apply the saved theme before first paint to avoid a flash of the wrong theme. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('disky-theme') || 'dark';
                document.documentElement.classList.toggle('dark', t === 'dark');
            } catch (e) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>

    @* Apply saved display/badge settings before first paint (mirrors atlas.js). *@
    <script>
        (function () {
            try {
                var d = JSON.parse(localStorage.getItem('disky-settings') || '{}');
                var r = document.documentElement;
                r.setAttribute('data-syntax-display', d.display || 'compact');
                r.setAttribute('data-advanced', d.advanced ? 'on' : 'off');
                var keys = ['kind', 'return', 'change', 'async', 'shared', 'since', 'intents'];
                var b = d.badges || {};
                keys.forEach(function (k) {
                    var v = (k in b) ? b[k] : true;
                    r.setAttribute('data-badge-' + k, v ? 'on' : 'off');
                });
                var docs = d.docs || {};
                var card = ['compact', 'standard', 'full'].indexOf(docs.card) >= 0 ? docs.card : 'standard';
                r.setAttribute('data-doc-card', card);
                r.setAttribute('data-doc-toc', docs.toc === false ? 'off' : 'on');
            } catch (e) {
                document.documentElement.setAttribute('data-syntax-display', 'compact');
                document.documentElement.setAttribute('data-doc-card', 'standard');
                document.documentElement.setAttribute('data-doc-toc', 'on');
            }
        })();
    </script>

    <ResourcePreloader/>

    @* Theme (shadcn contract, source of truth) first, then Blueprint, then the
       DiSky token aliases/extensions + layout. Blueprint's own token defaults
       live in @layer, so our unlayered theme.css always wins. *@
    <link rel="stylesheet" href="css/theme.css"/>
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css"/>
    <link rel="stylesheet" href="css/tokens.css"/>
    <link rel="stylesheet" href="css/ds-components.css"/>
    <link rel="stylesheet" href="css/site.css"/>
    <link rel="stylesheet" href="@Assets["app.css"]"/>
    <link rel="stylesheet" href="@Assets["DiSkyAtlas.styles.css"]"/>

    <link rel="icon" type="image/png" href="assets/favicon.png"/>

    <ImportMap/>
    <HeadOutlet @rendermode="InteractiveServer"/>
</head>

<body>
<Routes @rendermode="InteractiveServer"/>
<ReconnectModal/>
<script src="@Assets["_framework/blazor.web.js"]"></script>
<script src="js/atlas.js"></script>
</body>

</html>
